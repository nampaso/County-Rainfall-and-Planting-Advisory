def clean_machakos_data(raw_list, month_names):
    """Cleans raw string data for Machakos, converting valid entries to ints

    and imputing missing or invalid entries with the rounded average of valid data.
    """
    valid_values = []
    invalid_indices = []

    for idx, val in enumerate(raw_list):
        try:
            cleaned_val = int(val.strip())
            valid_values.append(cleaned_val)
        except ValueError:
            invalid_indices.append(idx)

    # Calculate rounded average of valid figures
    avg_imputed = round(sum(valid_values) / len(valid_values))

    cleaned_row = []
    imputed_months = []

    for idx, val in enumerate(raw_list):
        try:
            cleaned_row.append(int(val.strip()))
        except ValueError:
            cleaned_row.append(avg_imputed)
            imputed_months.append(month_names[idx])

    print("Imputed Months for Machakos:")
    for month in imputed_months:
        print(f"  - {month} (Imputed Value: {avg_imputed} mm)")

    return cleaned_row

machakos_clean = clean_machakos_data(machakos_raw, months)
